+    // MPH-nx: SDL2 on Horizon has one window, backed by the display's NWindow.
+    // Its fullscreen-desktop path changes the logical window size without
+    // resizing the NWindow buffer, so create the window at the panel size up
+    // front and never resize it; the renderer's logical size does the scaling.
+    (void)w; (void)h;
+    w = 1280;
+    h = 720;
+    flags &= ~static_cast<uint64_t>(SDL_WINDOW_RESIZABLE | SDL_WINDOW_ALLOW_HIGHDPI);
+#endif
     return SDL_CreateWindow(title, x, y, w, h, static_cast<uint32_t>(flags));
 #endif
 }
