+    const std::string cache = path + ".sha1cache";
+    char key[64];
+    std::snprintf(key, sizeof key, "%llu %lld", static_cast<unsigned long long>(rom.size()),
+                  have_stat ? static_cast<long long>(st.st_mtime) : -1ll);
+    if (have_stat) {
+        if (std::FILE* f = std::fopen(cache.c_str(), "r")) {
+            char line[160] = {};
+            const bool ok = std::fgets(line, sizeof line, f) != nullptr;
+            std::fclose(f);
+            std::string l(line);
+            while (!l.empty() && (l.back() == '\n' || l.back() == '\r')) l.pop_back();
+            const std::string want = std::string(key) + " ";
+            if (ok && l.size() == want.size() + 40 && l.compare(0, want.size(), want) == 0) {
+                std::fprintf(stderr, "[load] cartridge SHA-1 from cache\n");
+                return l.substr(want.size());
