+    const SDL_Rect white[] = {{x - r, y - t / 2, 2 * r + 1, t}, {x - t / 2, y - r, t, 2 * r + 1}};
+    SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
+    for (const auto& b : black) SDL_RenderFillRect(renderer, &b);
+    SDL_SetRenderDrawColor(renderer, 255, 255, 255, 255);
+    for (const auto& w : white) SDL_RenderFillRect(renderer, &w);
