+        }
+    }
+    const std::string sha = gba::sha1(rom.data(), rom.size()).hex();
+    if (have_stat) {
+        if (std::FILE* f = std::fopen(cache.c_str(), "w")) {
+            std::fprintf(f, "%s %s\n", key, sha.c_str());
+            std::fclose(f);
+        }
+    }
+    return sha;
