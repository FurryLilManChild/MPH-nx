+#if defined(__SWITCH__) && !defined(NDS_HAVE_SDL3)
+// MPH-nx diagnostics: which renderer SDL picked and what size it draws at.
+static void mphnx_log_renderer(SDL_Renderer* renderer, SDL_Window* window) {
+    SDL_RendererInfo info{};
+    int ow = 0, oh = 0, ww = 0, wh = 0;
+    SDL_GetRendererInfo(renderer, &info);
+    SDL_GetRendererOutputSize(renderer, &ow, &oh);
+    SDL_GetWindowSize(window, &ww, &wh);
+    std::fprintf(stderr,
+        "[mph-nx] renderer=%s flags=0x%x output=%dx%d window=%dx%d\n",
+        info.name ? info.name : "?", (unsigned)info.flags, ow, oh, ww, wh);
+}
+
+// Saves what the renderer drew (before present) at a few frame counts, so a
+// black TV can be told apart from a black render.
+static void mphnx_maybe_snapshot(SDL_Renderer* renderer) {
+    static unsigned frame = 0;
+    ++frame;
+    if (frame != 120 && frame != 600 && frame != 1800 && frame != 3600) return;
+    int ow = 0, oh = 0;
+    if (SDL_GetRendererOutputSize(renderer, &ow, &oh) != 0 || ow <= 0 || oh <= 0) return;
+    SDL_Surface* surf = SDL_CreateRGBSurfaceWithFormat(0, ow, oh, 32, SDL_PIXELFORMAT_ARGB8888);
+    if (!surf) return;
+    if (SDL_RenderReadPixels(renderer, nullptr, SDL_PIXELFORMAT_ARGB8888,
+                             surf->pixels, surf->pitch) == 0) {
+        char path[96];
+        std::snprintf(path, sizeof path, "/switch/mph-nx/logs/frame-%04u.bmp", frame);
+        SDL_SaveBMP(surf, path);
+        std::fprintf(stderr, "[mph-nx] snapshot %s (%dx%d)\n", path, ow, oh);
+    } else {
+        std::fprintf(stderr, "[mph-nx] snapshot read failed: %s\n", SDL_GetError());
+    }
+    SDL_FreeSurface(surf);
+}
+#endif
