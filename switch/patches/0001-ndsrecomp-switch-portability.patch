+// MPH-nx: text at an integer scale, using the notice font.
+void nx_draw_text(SDL_Renderer* renderer, int x, int y, int scale, const char* text) {
+    const int len = static_cast<int>(std::strlen(text));
+    const SDL_Rect bg{x - scale * 2, y - scale * 2, len * 6 * scale + scale * 3, 11 * scale};
+    SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
+    SDL_RenderFillRect(renderer, &bg);
+    SDL_SetRenderDrawColor(renderer, 255, 255, 255, 255);
+    for (int i = 0; i < len; ++i) {
+        const char* glyph = notice_glyph(text[i]);
+        for (int gy = 0; gy < 7; ++gy)
+            for (int gx = 0; gx < 5; ++gx)
+                if (glyph[gy * 5 + gx] == '1') {
+                    const SDL_Rect px{x + (i * 6 + gx) * scale, y + gy * scale, scale, scale};
+                    SDL_RenderFillRect(renderer, &px);
+                }
+    }
+}
