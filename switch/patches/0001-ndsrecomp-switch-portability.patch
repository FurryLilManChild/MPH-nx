+// MPH-nx: a touch cursor that stays visible on light and dark screens.
+void nx_draw_cursor(SDL_Renderer* renderer, const SDL_Rect& screen, float sx, float sy) {
+    const int x = screen.x + static_cast<int>(std::lround(sx * screen.w / 256.0f));
+    const int y = screen.y + static_cast<int>(std::lround(sy * screen.h / 192.0f));
+    const int r = std::max(8, screen.w / 40), t = std::max(2, screen.w / 240);
+    const SDL_Rect black[] = {{x - r - 1, y - t, 2 * r + 3, 2 * t + 1}, {x - t, y - r - 1, 2 * t + 1, 2 * r + 3}};
+    const SDL_Rect white[] = {{x - r, y - t / 2, 2 * r + 1, t}, {x - t / 2, y - r, t, 2 * r + 1}};
+    SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
+    for (const auto& b : black) SDL_RenderFillRect(renderer, &b);
+    SDL_SetRenderDrawColor(renderer, 255, 255, 255, 255);
+    for (const auto& w : white) SDL_RenderFillRect(renderer, &w);
+}
