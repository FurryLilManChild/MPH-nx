+static void mphnx_maybe_snapshot(SDL_Renderer* renderer) {
+    // Off unless /switch/mph-nx/snapshots.on exists: each capture stalls a frame.
+    static const bool enabled = [] {
+        FILE* f = std::fopen("/switch/mph-nx/snapshots.on", "rb");
+        if (f) std::fclose(f);
+        return f != nullptr;
+    }();
+    if (!enabled) return;
+    static unsigned frame = 0;
+    ++frame;
+    if (frame != 120 && frame != 600 && frame != 1800 && frame != 3600) return;
+    int ow = 0, oh = 0;
+    if (SDL_GetRendererOutputSize(renderer, &ow, &oh) != 0 || ow <= 0 || oh <= 0) return;
+    SDL_Surface* surf = SDL_CreateRGBSurfaceWithFormat(0, ow, oh, 32, SDL_PIXELFORMAT_ARGB8888);
+    if (!surf) return;
+    if (SDL_RenderReadPixels(renderer, nullptr, SDL_PIXELFORMAT_ARGB8888,
+                             surf->pixels, surf->pitch) == 0) {
+        char path[96];
+        std::snprintf(path, sizeof path, "/switch/mph-nx/logs/frame-%04u.bmp", frame);
+        SDL_SaveBMP(surf, path);
+        std::fprintf(stderr, "[mph-nx] snapshot %s (%dx%d)\n", path, ow, oh);
+    } else {
+        std::fprintf(stderr, "[mph-nx] snapshot read failed: %s\n", SDL_GetError());
+    }
+    SDL_FreeSurface(surf);
+}
